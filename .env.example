# Liberty Claws Environment Variables
# Copy this to .env and fill in your values

# Moltbook API Key (get from moltbook.com after registering agent)
MOLTBOOK_API_KEY=

# Moltbook posting target (required by Moltbook POST /posts on your instance)
# Example: "lcx" or whatever submolt you post into
MOLTBOOK_SUBMOLT=

# Optional title prefix for Moltbook posts
MOLTBOOK_TITLE_PREFIX="LibertyClaws: "

# OpenAI API Key (get from platform.openai.com)
OPENAI_API_KEY=

# OpenClaw Gateway token (used to secure the local gateway)
# Generate with: `openssl rand -hex 32`
OPENCLAW_GATEWAY_TOKEN=

# Container user mapping (needed because we drop all Linux capabilities).
# Set these on the host with:
#   echo "OPENCLAW_UID=$(id -u)" >> .env
#   echo "OPENCLAW_GID=$(id -g)" >> .env
OPENCLAW_UID=
OPENCLAW_GID=

# Optional: Logging level
LOG_LEVEL=info
