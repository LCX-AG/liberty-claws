# Liberty Claws Environment Variables
# Copy this to .env and fill in your values

# Moltbook API Key (get from moltbook.com after registering agent)
MOLTBOOK_API_KEY=

# Moltbook posting target (required by Moltbook POST /posts on your instance)
# Example: "lcx" or whatever submolt you post into
MOLTBOOK_SUBMOLT=

# Optional title prefix for Moltbook posts
MOLTBOOK_TITLE_PREFIX="LibertyClaws: "

# OpenAI API Key (get from platform.openai.com)
OPENAI_API_KEY=

# OpenClaw Gateway token (used to secure the local gateway)
# Generate with: `openssl rand -hex 32`
OPENCLAW_GATEWAY_TOKEN=

# Container user mapping (needed because we drop all Linux capabilities).
# Set these on the host with:
#   echo "OPENCLAW_UID=$(id -u)" >> .env
#   echo "OPENCLAW_GID=$(id -g)" >> .env
OPENCLAW_UID=
OPENCLAW_GID=

# Optional: Logging level
LOG_LEVEL=info

# ---------------- LibertyClaws comment auto-replies ----------------
# How often to run the comment-reply cron (OpenClaw cron syntax).
# Default: every 10 minutes.
LCX_REPLY_CRON="*/10 * * * *"

# Only scan posts created within the last N hours (default 24).
LCX_REPLY_LOOKBACK_HOURS=24

# Scan up to N recent posts for new comments (default 10).
LCX_REPLY_MAX_POSTS=10

# Scan the last N recent posts per run (default 3).
LCX_REPLY_POSTS_PER_RUN=3

# Reply to at most N newest *new* comments across those posts per run (default 2).
LCX_REPLY_MAX_PER_RUN=2

# Optional: seed a single comment on posts with zero external comments (default 0/off).
LCX_REPLY_ENABLE_SEED=0
LCX_REPLY_SEED_MAX_PER_RUN=1

# Optional: cache quiet posts to reduce API calls (default 0/off).
LCX_REPLY_ENABLE_POST_CACHE=0
LCX_REPLY_QUIET_POST_RECHECK_MINUTES=10

# Max replies per UTC day (default 10).
LCX_REPLY_MAX_PER_DAY=10

# Dry run (default 0). Set 1 to generate replies but NOT post them.
LCX_REPLY_DRY_RUN=0

# Lock self-heal: if a lock is older than this, treat it as stale and clear it.
LCX_REPLY_LOCK_STALE_MINUTES=15
